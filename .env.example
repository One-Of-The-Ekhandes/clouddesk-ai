# Copy to .env and fill in. Never commit .env.
# Provider: groq | gemini | ollama | mock  (mock runs fully offline, used in CI)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile
# OLLAMA_URL=http://localhost:11434/v1
# CLOUDDESK_DB=clouddesk.db
# IAM_SOURCE=snapshot   # snapshot (offline sample data) | aws (live, read-only via boto3)
